# ── IBM Db2 Connection ──────────────────────────────────────────────
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USER=
DB2_PASSWORD=
DB2_SCHEMA=

# ── IBM MQ Connection ───────────────────────────────────────────────
MQ_HOST=
MQ_PORT=1414
MQ_QMGR=
MQ_CHANNEL=
MQ_USER=
MQ_PASSWORD=
MQ_QUEUE=TEAM3.SUPPLYCHAIN

# ── Dashboard Settings ──────────────────────────────────────────────
DASHBOARD_MODE=local        # local (SQLite) | cloud (Db2)
STREAM_RATE_HZ=1.0          # rows per second in MQ replay
